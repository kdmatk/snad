{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snad-legal",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SUPPORT_RATE_LIMIT",
      "namespace_id": "2026102701",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    {
      "pattern": "snadlegal.org",
      "custom_domain": true
    },
    {
      "pattern": "www.snadlegal.org",
      "custom_domain": true
    }
  ]
}
